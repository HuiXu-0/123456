# 智学中枢后端配置样例 —— 复制为 .env 后按需修改。
# B0 阶段无任何密钥也能跑通全链路（所有项均有默认值）。

# 应用名（出现在 OpenAPI 标题与 health 回包）
APP_NAME=智学中枢后端

# API 前缀
API_PREFIX=/api/v1

# CORS 允许来源（逗号分隔；默认放行前端 Vite 3000/3001）
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 日志（LOG_FORMAT 可选 text/json；请求完成日志可按环境关闭）
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_REQUEST_COMPLETED=true

# LLM Provider（mock / deepseek / qwen / anthropic）—— B0 仅占位，后续阶段使用
LLM_PROVIDER=mock

DEEPSEEK_API_KEY=在此填入你的DeepSeek密钥

# 魔搭 ModelScope（模型管理·界面切换模型，接口文档 21）：推理 API 兼容 OpenAI 协议。
# 令牌在 modelscope.cn 个人中心生成；缺省为空 → 魔搭模型标记「未配 Key」，
# 调用时自动回落默认 DeepSeek / mock（绝不崩）。模型清单可按需覆盖。
MODELSCOPE_API_KEY=
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
# MODELSCOPE_MODELS=ZhipuAI/GLM-4.6,Qwen/Qwen3-32B,deepseek-ai/DeepSeek-V3.1
